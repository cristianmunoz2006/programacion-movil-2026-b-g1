# Copy to .env. Expo exposes vars prefixed EXPO_PUBLIC_ to the app at build time.
#
# If testing on a physical device with Expo Go, "localhost" means the PHONE, not your
# computer — use your computer's local network IP instead (e.g. http://192.168.1.50:3000).
# If testing on an Android emulator, use http://10.0.2.2:3000 (emulator's alias for the host
# machine's localhost). iOS simulator can use localhost directly.
EXPO_PUBLIC_API_URL="http://localhost:3000"
